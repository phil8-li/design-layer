{
  "name": "designlayer",
  "version": "0.1.0",
  "private": true,
  "description": "A Figma-like visual editor that attaches to your running React or Angular app and writes every change back to the component source.",
  "license": "MIT",
  "author": "Haoyang (Phil) Li",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phil8-li/design-layer.git"
  },
  "bugs": {
    "url": "https://github.com/phil8-li/design-layer/issues"
  },
  "homepage": "https://github.com/phil8-li/design-layer#readme",
  "keywords": [
    "nextjs",
    "angular",
    "tailwindcss",
    "visual-editor",
    "design-tools",
    "design-systems",
    "design-tokens",
    "devtools",
    "mcp",
    "react"
  ],
  "type": "module",
  "bin": {
    "designlayer": "./cli.mjs"
  },
  "exports": {
    "./config": "./config.mjs"
  },
  "files": [
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "build.mjs",
    "cli.mjs",
    "config.mjs",
    "designlayer.config.example.mjs",
    "dist/",
    "runtime/",
    "server/",
    "src/",
    "tools/",
    "tsconfig.json"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "build": "node build.mjs",
    "prepare": "node build.mjs",
    "verify": "node tools/build-icons.mjs --check && node tools/build-sonner-css.mjs --check && node tools/build-notices.mjs --check && node build.mjs --check && node cli.mjs --verify",
    "test": "node test/run.mjs",
    "test:standalone-next": "node test/standalone-next-cases.mjs"
  },
  "dependencies": {
    "@babel/parser": "^8.0.6",
    "esbuild": "^0.28.1",
    "motion": "^14.0.0",
    "motion-panels": "^0.6.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-rewrite-cli": "0.1.1",
    "sonner": "^2.0.8",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@phosphor-icons/core": "^2.1.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^29.1.1",
    "typescript": "7.0"
  }
}
